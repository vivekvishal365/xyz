# SignalX environment
#
# §39: API keys never reach the frontend. Only NEXT_PUBLIC_* vars are inlined
# into the client bundle, and those must be non-secret by contract.
# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
# Safe for the browser: the anon key is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SERVER ONLY. Bypasses row-level security. Never prefix this NEXT_PUBLIC_,
# never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# TEMPORARY — UI testing without signing in.
# "true" makes the app routes publicly reachable and supplies a placeholder
# user. A red banner appears on every page while it is on. Anything other than
# exactly "true" leaves authentication enabled.
#
# NOTE: this one is inlined at BUILD time. Setting it in Vercel does nothing
# until the next deploy. Confirm what is actually live at /api/v1/health.
NEXT_PUBLIC_AUTH_BYPASS="false"

# Server-only equivalent, read at runtime rather than inlined. Either variable
# enables the bypass. Prefer this one when toggling on a hosting platform.
# AUTH_BYPASS="true"

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
# Free, from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""

# Open-Meteo needs no key.

# ---------------------------------------------------------------------------
# Inngest (the ingestion pipeline runtime)
# ---------------------------------------------------------------------------
# LOCAL: set INNGEST_DEV=1. Without it — and without a signing key — the SDK
# refuses to serve and /api/inngest returns 500 with no useful message.
INNGEST_DEV="1"
# INNGEST_LOG_LEVEL="debug"

# PRODUCTION: INNGEST_DEV must be UNSET, and BOTH of these are required.
# Missing them is the same 500, which will look like a broken deployment.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Migrations — Supabase dashboard -> Project Settings -> Database -> URI
# ---------------------------------------------------------------------------
# SUPABASE_DB_URL=""

# ---------------------------------------------------------------------------
# Later phases
# ---------------------------------------------------------------------------
# MARKET_DATA_API_KEY=""      # D2 vendor, TBD
# LLM_API_KEY=""              # D8, provider TBD
