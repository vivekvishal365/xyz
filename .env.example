# SignalX environment
#
# §39: API keys never reach the frontend. Only NEXT_PUBLIC_* vars are inlined
# into the client bundle, and those must be non-secret by contract.
# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
# Safe for the browser: the anon key is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SERVER ONLY. Bypasses row-level security. Never prefix this NEXT_PUBLIC_,
# never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Phase 1+ — not required to run Phase 0
# ---------------------------------------------------------------------------
# FRED_API_KEY=""
# MARKET_DATA_API_KEY=""      # D2 vendor, TBD
# LLM_API_KEY=""              # D8, provider TBD
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
