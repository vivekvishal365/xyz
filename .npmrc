# Inngest declares an OPTIONAL peer dependency on @sveltejs/kit, which npm's
# resolver still tries to satisfy — and the SvelteKit chain wants Vite 8 while
# Vitest here is on Vite 7. Nothing in this project uses SvelteKit, and the
# install confirms neither @sveltejs/* nor Vite 8 ends up in the tree.
#
# Set here rather than passed as a flag so `npm ci` in CI resolves identically
# to local installs.
legacy-peer-deps=true
